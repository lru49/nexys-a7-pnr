+
+// The pins come from a reference build of a *different* netlist: two cells
+// that shared a slice there can disagree here (control set, LUT5/LUT6 input
+// sharing, carry use), and the placers bind -o preplaced cells without a
+// validity check, so one bad slice only shows at the post-placement check.
+// Bind the pins now that the cell tags exist, and unpin -- with their whole
+// clusters -- the cells of every tile the pins alone make invalid, until none
+// is left.
+void XilinxImpl::bind_preplaced()
+{
+    if (!ctx->args.options.count("preplaced"))
+        return;
+    std::vector<CellInfo *> pinned;
+    for (auto &c : ctx->cells) {
+        CellInfo *ci = c.second.get();
+        auto f = ci->attrs.find(id_BEL);
+        if (f == ci->attrs.end() || ci->bel != BelId())
+            continue;
+        BelId bel = ctx->getBelByNameStr(f->second.as_string());
+        if (bel == BelId() || !ctx->isValidBelForCellType(ci->type, bel) || !ctx->checkBelAvail(bel)) {
+            ci->attrs.erase(id_BEL);
+            continue;
+        }
+        ctx->bindBel(bel, ci, STRENGTH_USER);
+        pinned.push_back(ci);
+    }
+    int unpinned = 0, bad_tiles = 0, rounds = 0;
+    while (true) {
+        std::vector<CellInfo *> drop;
+        pool<IdString> drop_names;
+        auto add_drop = [&](CellInfo *x) {
+            if (drop_names.insert(x->name).second)
+                drop.push_back(x);
+        };
+        pool<int> seen_tiles;
+        for (CellInfo *ci : pinned) {
+            if (ci->bel == BelId() || seen_tiles.count(ci->bel.tile))
+                continue;
+            if (ctx->isBelLocationValid(ci->bel))
+                continue;
+            seen_tiles.insert(ci->bel.tile);
+            if (bad_tiles < 10)
+                ctx->isBelLocationValid(ci->bel, true); // explain
+            bad_tiles++;
+            int tx, ty;
+            tile_xy(ctx->chip_info, ci->bel.tile, tx, ty);
+            for (BelId b : ctx->getBelsByTile(tx, ty)) {
+                CellInfo *o = ctx->getBoundBelCell(b);
+                if (o == nullptr || o->belStrength != STRENGTH_USER || !o->attrs.count(id_BEL))
+                    continue;
+                add_drop(o);
+                if (o->cluster != ClusterId()) {
+                    CellInfo *root = ctx->getClusterRootCell(o->cluster);
+                    add_drop(root);
+                    for (CellInfo *ch : root->constr_children)
+                        add_drop(ch);
+                }
+            }
+        }
+        if (drop.empty())
+            break;
+        rounds++;
+        for (CellInfo *o : drop) {
+            if (o->bel != BelId() && o->belStrength == STRENGTH_USER)
+                ctx->unbindBel(o->bel);
+            if (o->attrs.erase(id_BEL))
+                unpinned++;
+        }
+    }
+    log_info("Pre-placed: %d cell(s) bound; %d tile(s) invalid with this netlist, %d cell(s) unpinned there (%d "
+             "round(s)).\n",
+             int(pinned.size()) - unpinned, bad_tiles, unpinned, rounds);
 }
 
